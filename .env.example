# Public browser configuration ONLY. Copy to .env.local and rebuild CRA.
# Supabase URL and anon/publishable key are intentionally public, RLS-protected.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Optional override; defaults to ${REACT_APP_SUPABASE_URL}/functions/v1/study-tutor
# REACT_APP_TUTOR_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/study-tutor
# NEVER add DEEPSEEK_API_KEY, service-role keys, or ADMIN_USER_ID here.
