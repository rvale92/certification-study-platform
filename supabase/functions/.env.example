# Server-only Edge Function configuration. Copy to an ignored .env file.
# Hosted Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.
# Never prefix these secrets with REACT_APP_, NEXT_PUBLIC_, or VITE_.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
ADMIN_USER_ID=replace_with_your_verified_supabase_auth_user_uuid
ALLOWED_ORIGINS=https://rvale92.github.io,http://localhost:3001,http://127.0.0.1:3001
